# Copy this file to a new file named .env for local development. NEVER commit .env (it is in .gitignore).
# Real values for the live site are set in Render's Environment tab, not in a file.

# --- Required ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-me-with-a-long-random-string

# Local development only. The default is False (safe), so on your own computer you MUST set True here.
# Leave this out, or set False, on Render.
DEBUG=True

# --- Optional ---
# Database. Leave empty to use the local db.sqlite3 file.
DATABASE_URL=

# Shared cache (Redis). Needed in production so the login lockout works across server processes.
REDIS_URL=

# Stripe (use TEST keys locally). The webhook secret comes from `stripe listen` or the Stripe dashboard.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SendGrid) and image storage (Cloudinary)
SENDGRID_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First owner account. Only used when the account does not exist yet. There is NO default account:
# if these three are empty, no superuser is created. The password must pass Django's password checks.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# How long browsers must remember "https only" (seconds). Starts at 1 hour; see docs/DEPLOYMENT_CHECKLIST.md.
HSTS_SECONDS=3600
